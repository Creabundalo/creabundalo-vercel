{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=(), usb=()"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.scw.cloud; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
      ]
    }
  ]
}
